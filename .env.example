# Copy to .env on the server and fill in. Never commit .env.

# The domain that points at this server (an A/AAAA DNS record). Caddy gets the HTTPS certificate for it.
TOQO_DOMAIN=toqo.example.com
# Same domain, comma-separated if there are several.
TOQO_ALLOWED_HOSTS=toqo.example.com

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
TOQO_SECRET_KEY=

# Local time of the event (game start times, "since 14:05" on the queue board).
TOQO_TIME_ZONE=Europe/Amsterdam
